# ==============================================================================
# MAKAUT CampusSense — Git Ignore Configuration
# Comprehensive rules for Java 21, Spring Boot, Maven, IDEs, OS, and Secrets
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Java & Maven Build Output
# ------------------------------------------------------------------------------
*.class
target/
bin/
out/
build/
.gradle/
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# Maven Release & Plugin Artifacts
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.next
release.properties
dependency-reduced-pom.xml
buildNumber.properties
.mvn/timing.properties

# Bundled Local Maven Installations
apache-maven-*/
apache-maven/

# ------------------------------------------------------------------------------
# 2. Environment Variables & Secrets (CRITICAL: Never commit to Git)
# ------------------------------------------------------------------------------
.env*
!.env.example
.env
.env.local
.env.*.local
*.private
*secret*

# Spring Profile Secrets
application-prod.yml
application-prod.properties
application-local.yml
application-local.properties
application-secret.yml
application-secret.properties

# Keys, Certificates, and Tokens
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
*.crt
credentials.json
service-account*.json
token.json
id_rsa*
id_ed25519*

# ------------------------------------------------------------------------------
# 3. IDEs & Text Editors
# ------------------------------------------------------------------------------
# VS Code
.vscode/
*.code-workspace
.history/

# IntelliJ IDEA
.idea/
*.iml
*.iws
*.ipr
.idea_modules/

# Eclipse
.apt_generated/
.apt_generated_tests/
.classpath
.factorypath
.project
.settings/
.springBeans
.sts4-cache/

# NetBeans
/nbproject/private/
/nbbuild/
/dist/
nbproject/genfiles.properties

# Vim / Emacs / Sublime
*.swp
*.swo
.*.sw[a-p]
*~
\#*\#
.#*
*.sublime-project
*.sublime-workspace

# ------------------------------------------------------------------------------
# 4. Logs, Diagnostics & Crash Dumps
# ------------------------------------------------------------------------------
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
hs_err_pid*
replay_pid*

# ------------------------------------------------------------------------------
# 5. Databases, Local Storage & Docker Volumes
# ------------------------------------------------------------------------------
*.db
*.sqlite
*.sqlite3
*.h2.db
*.trace.db
postgres_data/
pgdata/
data/
tmp/
temp/
*.tmp
*.bak
*.patch
*.diff

# ------------------------------------------------------------------------------
# 6. Operating System Files
# ------------------------------------------------------------------------------
# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
*.lnk
$RECYCLE.BIN/

# macOS
.DS_Store
.AppleDouble
.LSOverride
Icon\r\r
._*
.Spotlight-V100
.Trashes

# Linux
.fuse_hidden*
.directory
.Trash-*

# ------------------------------------------------------------------------------
# 7. Local Project Scratch & Raw Extraction Dumps
# ------------------------------------------------------------------------------
# Local scratch folder and scripts
scratch/

# Raw local syllabus extraction directories (curated files live in static/ & docs/)
/1st year MAKAUT-CampusSense/
/CSE(3rd to 8th sem)/

# Node / Frontend temporary folders (if used)
node_modules/
.npm/
.yarn/

# ------------------------------------------------------------------------------
# 8. Python Virtual Environments & Caches
# ------------------------------------------------------------------------------
.venv/
venv/
ENV/
env/
__pycache__/
*.py[cod]
*$py.class
*.pyc

# ------------------------------------------------------------------------------
# 9. Local Vector Store & RAG Embedding Cache
# ------------------------------------------------------------------------------
.makaut_rag/
vector_store/

