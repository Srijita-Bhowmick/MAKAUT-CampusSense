# ==============================================================================
# MAKAUT CampusSense - Environment Variables Template
# Copy this file to .env or .env.local and populate with your own credentials.
# NOTE: .env and .env.local are gitignored to prevent secret leaks.
# ==============================================================================

# Clerk Authentication (https://dashboard.clerk.com)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key
CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key

# Optional: LLM & Embedding Providers (Default is 'mock' for zero-cost offline development)
LLM_PROVIDER=mock
LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=your_openai_api_key_here
EMBEDDING_PROVIDER=mock
EMBEDDING_MODEL=text-embedding-3-small

# Optional: PostgreSQL Database (Active when running with profile: postgres)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=campussense
DB_USER=campussense_user
DB_PASSWORD=campussense_password
