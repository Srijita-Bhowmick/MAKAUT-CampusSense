# Runtime & Profiles
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# Cloudflare Edge Configuration
CLOUDFLARE_ZONE_ID=your_cloudflare_zone_id_here
CLOUDFLARE_PAGES_URL=https://campussense.pages.dev

# Clerk Authentication
CLERK_PUBLISHABLE_KEY=pk_test_placeholder_key_here
CLERK_SECRET_KEY=sk_test_placeholder_key_here

# AI Ingestion & RAG Providers
LLM_PROVIDER=gemini
LLM_MODEL=gemini-flash-lite-latest
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here
EMBEDDING_PROVIDER=deterministic

# Persistence Layer (PostgreSQL 16 + pgvector)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=campussense
DB_USER=campussense_user
DB_PASSWORD=your_secure_password_here